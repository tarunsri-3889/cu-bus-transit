# GEMINI_API_KEY: Required server-side for Gemini AI & Google Maps Grounding (/api/maps-grounding).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Required client-side for the interactive Google Maps JavaScript API layer
# (@vis.gl/react-google-maps). Restrict this key to HTTP referrers and the Maps JavaScript API.
# If omitted or empty, the app remains functional using the Google Maps search/link fallback.
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_API_BASE_URL: Optional explicit backend origin for packaged Android/Capacitor builds
# (e.g., http://10.0.2.2:3000 for Android Emulator or https://your-private-backend.example).
# Leave empty for standard Web/PWA deployments to use same-origin (/api/*) requests.
VITE_API_BASE_URL=""

# CORS_ALLOWED_ORIGINS: Optional comma-separated extra origins allowed to call /api/* on server.ts.
# Capacitor Android WebView origins (https://localhost, http://localhost) are allowed automatically.
CORS_ALLOWED_ORIGINS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
